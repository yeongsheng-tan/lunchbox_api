{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.20.0/.schema/devbox.schema.json",
  "packages": {
    "postgresql_19": "latest",
    "gigalixir": "latest",
    "corepack": "latest",
    "nodejs": {
      "version": "26"
    },
    "beam29Packages.elixir_1_20": "1.20.5"
  },
  "env": {
    "DEVBOX_COREPACK_ENABLED": "true",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "BASIC_AUTH_USERNAME": "specialUserName",
    "BASIC_AUTH_PASSWORD": "superSecretPassword"
  },
  "shell": {
    "init_hook": [
      ". ./set-env.sh"
    ],
    "scripts": {
      "test": "mix test",
      "dev": "mix phx.server"
    }
  }
}
